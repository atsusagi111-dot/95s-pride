{
  // 95s PRIDE の Cloudflare Workers 設定(サイト配信 + API + D1)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "95s-pride",
  "account_id": "f0a2a1291069089cebb2a90b61004e80",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  // 静的ファイル(scripts/build-public.mjs が public/ に集める)。/api/* と /assets/* は Worker を先に通す
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/assets/*"]
  },

  // 画像の縮小(アンケートの写真を、正方形・小さなサイズにする)
  "images": { "binding": "IMAGES" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "95s-pride",
      "database_id": "f132cedf-1677-477a-bf99-15e0dff5f73a",
      "migrations_dir": "migrations"
    }
  ],

  // 10分おきに、期限切れのコードの掃除と、送れなかったお礼メールの再送を行う
  "triggers": { "crons": ["*/10 * * * *"] },

  // 秘密でない設定。秘密(SESSION_SECRET, GMAIL_USER, GMAIL_APP_PASSWORD)は wrangler secret put で入れる
  "vars": {
    "MAIL_SENDER_NAME": "95s PRIDE",
    "MAIL_FROM": "95spride.official@gmail.com",
    "MAIL_REPLY_TO": "95spride.official@gmail.com"
  }
}
